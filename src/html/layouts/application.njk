{%- from 'macros/helpers.njk' import spriteTarget -%}
<!doctype html>
<html lang="{{ lang or meta.lang }}">
<head prefix="{{ prefix }}">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {% if images %}
    {# `images` can be collection populated by `cloudinary` task, variable defined in template or just set via
      `images: true` in `data/global.mjs` to enable this if you use another way to upload images to cloudinary #}
    <meta http-equiv="delegate-ch"
          content="sec-ch-width https://res.cloudinary.com; sec-ch-dpr https://res.cloudinary.com; sec-ch-viewport-width https://res.cloudinary.com;">
  {% endif %}
  {% block head_pragma %}{% endblock %}
  <title>{% block title %}{{ meta.title }} {{ title }}{% endblock %}</title>
  {% if images %}
    <link rel="preconnect" href="https://res.cloudinary.com">
  {% endif %}
  {% block head_preconnect %}{% endblock %}
  {% block head_async_scripts %}{% endblock %}
  {% block head_import_stylesheets %}{% endblock %}
  {% block head_scripts %}{% endblock %}
  <link rel="stylesheet" href="{{ 'index.css' | assetUrl('stylesheets') }}">
  {% block head_stylesheets %}{% endblock %}
  {% block head_preload %}{% endblock %}
  {% block head_defer_scripts %}{% endblock %}
  {% block head_prefetch %}{% endblock %}
  <meta name="description" content="{{ description or meta.description }}">
  <meta name="generator" content="{{ generator or meta.generator }}">
  <meta name="color-scheme" content="light dark">
  <meta name="text-scale" content="scale">
  <link rel="manifest" href="{{ 'manifest.json' | assetUrl('static') }}">
  <link rel="canonical" href="{{ canonicalUrl or page.url | resolveUrl(meta.url) }}">
  {% include "shared/app-icons.html" %}
  {% block head %}{% endblock %}
</head>
<body {% if schemaType %}itemscope itemtype="{{ schemaType }}"{% endif %}>
{% block content %}{% endblock %}
{% block scripts %}{% endblock %}
{{ spriteTarget() }}
</body>
</html>
